DISCORD_TOKEN=your_discord_bot_token_here

MONGO_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/Discord_bot?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB_NAME=Discord_bot

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_OPEN_URL=http://raspberry-pi-ip:8080

# Optional fallback IDs.
# Approval/role IDs are only used before /setup is saved in MongoDB.
# You can leave them out of your real .env if your server already ran /setup.
APPROVAL_CHANNEL_ID=0
REQUEST_INVITE_CHANNEL_ID=1393801371542622308
PENDING_ROLE_ID=0
COMRADE_ROLE_ID=0
BOT_ROLE_ID=0
PRESIDENT_ROLE_ID=0
HUMAN_APPROVE_REQUIRED=3
BOT_APPROVE_REQUIRED=3
RULES_CHANNEL_ID=1337444919773761629

# Security settings are global, so add these to your real .env if you want
# values different from config.py defaults.
SECURITY_ENABLED=true
SECURITY_LOG_CHANNEL_ID=1441224922486542387
SECURITY_TIMEOUT_SECONDS=7200
SECURITY_DM_OWNER_ID=PUT_MY_DISCORD_USER_ID_HERE
